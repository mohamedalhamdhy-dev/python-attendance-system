# Never use these example values as secrets. Run python scripts/setup_env.py
DATABASE_URL=mysql+pymysql://presence_app:REPLACE_ME@host.docker.internal:3306/presence_saas?charset=utf8mb4
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
APP_TIMEZONE=Asia/Dubai
MIN_CHECKOUT_INTERVAL_MINUTES=30
BIOMETRIC_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_URLSAFE_BASE64
FACE_MATCH_THRESHOLD=0.47
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_URLSAFE_BASE64
BACKUP_DIRECTORY=/app/backups
BACKUP_AT=02:00
BACKUP_TIMEZONE=Asia/Dubai
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULED=true
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=presence-attendance

# Backup DB transport: auto disables TLS ONLY on local host / host.docker.internal.
BACKUP_DB_TLS_MODE=auto
